{
  "name": "@app-base/native",
  "productName": "App Base",
  "description": "A minimal Django, Next.js and Electron app",
  "author": "App Base contributors",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package:mac": "electron-builder --mac dir --publish never"
  },
  "build": {
    "appId": "dev.appbase.app",
    "productName": "App Base",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "frontend"
      },
      {
        "from": "../backend/dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
