{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": ["version", "groups"],
  "properties": {
    "version": {
      "const": 1,
      "type": "number"
    },
    "groups": {
      "additionalProperties": false,
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$": {
          "anyOf": [
            {
              "const": 1,
              "type": "number"
            },
            {
              "const": 2,
              "type": "number"
            }
          ]
        }
      }
    }
  }
}
